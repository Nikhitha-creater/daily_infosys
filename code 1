#DISPLAY THE FRAMES IN GRID
from IPython.display import display, HTML
from PIL import Image
import os
import io
import base64

folder_path = "frames"  # Your frames folder
N = 6  # Number of frames to display in a grid

html_str = ""

files = sorted(os.listdir(folder_path))[:N]

for file in files:
    file_path = os.path.join(folder_path, file)
    
    # Open image and convert to base64
    with open(file_path, "rb") as f:
        img_bytes = f.read()
    encoded = base64.b64encode(img_bytes).decode()
    
    # Add image to HTML string
    html_str += f'<img src="data:image/jpeg;base64,{encoded}" width="200" style="margin:5px;">'

# Display all images in a row
display(HTML(html_str))


